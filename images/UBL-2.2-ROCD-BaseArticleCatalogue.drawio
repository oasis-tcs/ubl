<mxfile host="UBL-TC" agent="UBL artwork pipeline, JSON to draw.io">
  <diagram id="UBL-2.2-ROCD-BaseArticleCatalogue" name="UBL-2.2-ROCD-BaseArticleCatalogue">
    <mxGraphModel dx="515" dy="224" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="543" pageHeight="253" math="0" shadow="0">
      <root>
        <mxCell id="0" style="" />
        <mxCell id="1" parent="0" style="" />
        <object label="" ubl-kind="frame" ubl-offset="14" id="frame">
          <mxCell parent="1" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=0;whiteSpace=wrap;collapsible=0;fillColor=none;strokeWidth=2;" vertex="1">
            <mxGeometry height="223" width="513" x="15" y="15" as="geometry" />
          </mxCell>
        </object>
        <object label="Producer" ubl-kind="lane" id="lane-producer">
          <mxCell parent="frame" style="swimlane;expand=0;horizontal=1;startSize=23;swimlaneLine=0;collapsible=0;html=1;fillColor=none;fontStyle=0;spacing=0;spacingRight=18;" vertex="1">
            <mxGeometry height="223" width="250" as="geometry" />
          </mxCell>
        </object>
        <object label="" ubl-kind="initial" id="initial-producer">
          <mxCell parent="lane-producer" style="ellipse;shape=startState;fillColor=#000000;strokeColor=none;html=1;" vertex="1">
            <mxGeometry height="26" width="26" x="60" y="24" as="geometry" />
          </mxCell>
        </object>
        <object label="Send Catalogue" ubl-kind="action" id="action-send-catalogue">
          <mxCell parent="lane-producer" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;whiteSpace=nowrap;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingRight=3;spacingBottom=1;" vertex="1">
            <mxGeometry height="29" width="121" x="12" y="118" as="geometry" />
          </mxCell>
        </object>
        <object label="" ubl-kind="flow" ubl-flow="control" id="flow-initial-producer-to-send-catalogue">
          <mxCell edge="1" parent="lane-producer" source="initial-producer" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;exitX=0.480769;exitY=0.8473;" target="action-send-catalogue">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object label="Retailer" ubl-kind="lane" id="lane-retailer">
          <mxCell parent="frame" style="swimlane;expand=0;horizontal=1;startSize=22;swimlaneLine=0;collapsible=0;html=1;fillColor=none;fontStyle=0;spacing=0;spacingRight=5;" vertex="1">
            <mxGeometry height="223" width="263" x="250" as="geometry" />
          </mxCell>
        </object>
        <object label="Catalogue" ubl-kind="object" ubl-between="[&quot;lane-producer&quot;, &quot;lane-retailer&quot;]" ubl-lane="null" id="object-catalogue">
          <mxCell parent="lane-retailer" style="rounded=0;html=1;whiteSpace=nowrap;fontStyle=3;align=center;verticalAlign=middle;spacing=0;spacingLeft=1;spacingBottom=2;strokeWidth=2;" vertex="1">
            <mxGeometry height="32" width="76" x="-39" y="117" as="geometry" />
          </mxCell>
        </object>
        <object label="Receive Catalogue" ubl-kind="action" id="action-receive-catalogue">
          <mxCell parent="lane-retailer" style="rounded=1;absoluteArcSize=1;arcSize=25;html=1;whiteSpace=nowrap;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingRight=4;spacingBottom=1;" vertex="1">
            <mxGeometry height="29" width="121" x="129" y="118" as="geometry" />
          </mxCell>
        </object>
        <object label="" ubl-kind="final" id="final-retailer">
          <mxCell parent="lane-retailer" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1">
            <mxGeometry height="17" width="18" x="181" y="198" as="geometry" />
          </mxCell>
        </object>
        <object label="" ubl-kind="flow" ubl-flow="object" id="flow-catalogue-to-receive-catalogue">
          <mxCell edge="1" parent="lane-retailer" source="object-catalogue" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;exitX=1;exitY=0.484375;" target="action-receive-catalogue">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
        <object label="" ubl-kind="flow" ubl-flow="control" id="flow-receive-catalogue-to-final-retailer">
          <mxCell edge="1" parent="lane-retailer" source="action-receive-catalogue" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitPerimeter=0;entryPerimeter=0;entryX=0.472222;entryY=0;" target="final-retailer">
