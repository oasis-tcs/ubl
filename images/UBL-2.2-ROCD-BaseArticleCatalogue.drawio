        </object>
        <object label="" ubl-kind="flow" ubl-flow="object" id="flow-send-catalogue-to-catalogue">
          <mxCell edge="1" parent="frame" source="action-send-catalogue" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitPerimeter=0;entryPerimeter=0;entryX=0;entryY=0.484375;" target="object-catalogue">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
