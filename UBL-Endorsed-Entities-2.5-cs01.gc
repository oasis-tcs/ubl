         </Value>
         <Value ColumnRef="ComponentName">
            <SimpleValue>CalculationSequenceNumeric</SimpleValue>
         </Value>
         <Value ColumnRef="Cardinality">
            <SimpleValue>0..1</SimpleValue>
         </Value>
         <Value ColumnRef="Definition">
            <SimpleValue>The number of this tax total in the sequence of tax totals corresponding to the order in which multiple taxes are applied. If all taxes are applied to the same taxable amount (i.e., their order of application is inconsequential), then CalculationSequenceNumeric is 1 for all tax totals applied to a given amount.</SimpleValue>
         </Value>
         <Value ColumnRef="DictionaryEntryName">
            <SimpleValue>Tax Total. Calculation Sequence. Numeric</SimpleValue>
         </Value>
         <Value ColumnRef="ObjectClass">
            <SimpleValue>Tax Total</SimpleValue>
         </Value>
